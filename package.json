{
  "name": "ring-office",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build-storybook": "storybook build --quiet",
    "build": "pnpm vite build",
    "eject": "react-scripts eject",
    "eslint:fix": "eslint --fix ./src/",
    "lint": "eslint --max-warnings=20 --cache src && tsc --noEmit",
